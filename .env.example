# Example Environment Configuration
# Copy this file to .env and adjust values for your target test environment.
# Do not commit real environment credentials or internal URLs to source control.

# Target URL of the form under test
FORM_URL=https://example.com

# Target test data
TEST_FIRST_NAME=SampleFirstName
TEST_GENDER=Male
TEST_STATE=SampleState
TEST_COUNTRY=SampleCountry

# Browser execution mode (0 = headed/visible browser window, 1 = headless mode)
HEADLESS=0
